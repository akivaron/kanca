# Example for server operators: provide a hostname and a valid certificate.
# Konfigurasi ini hanya mempublikasikan endpoint ingest, bukan UI atau API admin.
limit_req_zone $binary_remote_addr zone=kanca_gateway:10m rate=30r/m;
server {
    listen 443 ssl;
    server_name gateway.example.com;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    client_max_body_size 4m;
    location ~ ^/v1/ingest/src_[0-9a-f]{32}(/media)?$ {
        limit_req zone=kanca_gateway burst=5 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8765;
        proxy_read_timeout 110s;
    }
    location / { return 404; }
}
